# Copy this file to .env and fill in real values. .env is gitignored — never commit it.
#
# Every platform is optional at the code level (benchmark/config.py skips platforms
# whose required env vars are missing) so you can develop/test against whichever
# accounts you already have.

# Where THIS run's client actually executes — stamped into every result JSON
# and shown in the generated report, so a dev-sandbox validation run is never
# silently mixed in with the real region-matched benchmark run. Set this to
# something identifying, e.g. "gcp-us-east4-vm" for the real run, or
# "dev-sandbox" while iterating on the harness locally.
BENCHMARK_CLIENT_ENV=unspecified

# --- CognoDB Cloud (required target) ---------------------------------------
# console.cognodb.com -> create free c0 instance -> copy URI + password shown once.
COGNODB_URI=bolt+s://<instance-id>.databases.cognodb.cloud
COGNODB_USER=cognodb
COGNODB_PASSWORD=

# --- Neo4j AuraDB Free -------------------------------------------------------
# console.neo4j.io -> create Free instance -> download the generated .txt credentials.
AURA_URI=neo4j+s://<instance-id>.databases.neo4j.io
AURA_USER=neo4j
AURA_PASSWORD=

# --- FalkorDB Cloud Free ------------------------------------------------------
# app.falkordb.cloud -> create free instance -> host/port/user/password from the dashboard.
# FALKORDB_HOST may be pasted as "host" or "host:port" — the adapter splits it either way.
# FALKORDB_USER is required (Redis ACL auth, not just a password) — the dashboard usually
# shows this as "falkordb", not "default".
FALKORDB_HOST=<instance>.falkordb.cloud
FALKORDB_PORT=6379
FALKORDB_USER=falkordb
FALKORDB_PASSWORD=
FALKORDB_GRAPH=cit_hepph
# Set to true only if your instance's dashboard explicitly shows a TLS/SSL endpoint —
# confirmed against a real free instance that ssl=false is correct by default.
FALKORDB_SSL=false

# --- Memgraph (self-hosted, resource-capped via docker/docker-compose.yml) --
# `docker compose -f docker/docker-compose.yml up -d memgraph`
MEMGRAPH_URI=bolt://localhost:7688
MEMGRAPH_USER=
MEMGRAPH_PASSWORD=

# --- ArangoDB (self-hosted, resource-capped via docker/docker-compose.yml) --
# `docker compose -f docker/docker-compose.yml up -d arangodb`
ARANGO_URL=http://localhost:8529
ARANGO_USER=root
ARANGO_PASSWORD=changeme
ARANGO_DB=cit_hepph
